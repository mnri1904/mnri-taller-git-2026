{
  "openapi": "3.0.3",
  "info": {
    "title": "Minecraft de Marcelo Romero — entidades y explosiones",
    "version": "1.0.0",
    "contact": {"name": "Marcelo Romero", "url": "https://github.com/mnri1904/mnri-taller-git-2026"},
    "description": "API persistida de A1. Para probar la simulación, crear un Creeper, un Zombie y un Cerdo con los ejemplos del POST. Usar el id devuelto para el Creeper al detonar; consultar luego los tres ids. La simulación modifica la base: no es una consulta de solo lectura."
  },
  "servers": [{"url": "/", "description": "El servidor que publica este documento"}],
  "tags": [{"name": "Entidades", "description": "Filas persistidas en H2"}, {"name": "Simulación", "description": "Reglas de explosión"}],
  "paths": {
    "/api/minecraft/entidades": {
      "get": {
        "operationId": "listarEntidades",
        "tags": ["Entidades"],
        "description": "Usar después de una simulación para observar qué filas cambiaron.",
        "summary": "Listar las entidades guardadas, incluidas las desaparecidas",
        "responses": {
          "200": {"description": "Lista de entidades", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Entidad"}}}}}
        }
      },
      "post": {
        "operationId": "crearEntidad",
        "tags": ["Entidades"],
        "description": "Enviar uno de los ejemplos y guardar el id recibido para las siguientes operaciones.",
        "summary": "Crear una entidad con un ID nuevo",
        "requestBody": {"$ref": "#/components/requestBodies/DatosEntidad"},
        "responses": {
          "201": {
            "description": "Entidad creada",
            "headers": {"Location": {"description": "Ruta del nuevo recurso", "schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Entidad"}}}
          },
          "400": {"description": "VIDA_INVALIDA: vida fuera del rango. REGLA_MINECRAFT_INVALIDA: tipo desconocido o campos obligatorios ausentes.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorJuego"}}}}
        }
      }
    },
    "/api/minecraft/entidades/{id}": {
      "parameters": [{"$ref": "#/components/parameters/Id"}],
      "get": {
        "operationId": "consultarEntidad",
        "tags": ["Entidades"],
        "description": "Una entidad desaparecida sigue siendo consultable con vida cero.",
        "summary": "Leer el estado guardado de una entidad",
        "responses": {"200": {"$ref": "#/components/responses/EstadoGuardado"}, "404": {"$ref": "#/components/responses/NoEncontrada"}}
      },
      "put": {
        "operationId": "actualizarEntidad",
        "tags": ["Entidades"],
        "summary": "Reemplazar la vida y la posición de una entidad activa",
        "description": "Enviar también el tipo original. Un PUT no puede revivir a una entidad desaparecida. Un rechazo deja la fila sin cambios.",
        "requestBody": {"$ref": "#/components/requestBodies/DatosEntidad"},
        "responses": {
          "200": {"$ref": "#/components/responses/EstadoGuardado"},
          "400": {"description": "ENTIDAD_DESAPARECIDA, VIDA_INVALIDA o REGLA_MINECRAFT_INVALIDA (por ejemplo, cambio de tipo).", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorJuego"}}}},
          "404": {"$ref": "#/components/responses/NoEncontrada"}
        }
      },
      "delete": {
        "operationId": "eliminarEntidad",
        "tags": ["Entidades"],
        "description": "Tras el borrado, un GET del mismo id devuelve 404.",
        "summary": "Borrar la fila de la entidad",
        "responses": {"204": {"description": "Eliminada; sin cuerpo de respuesta"}, "404": {"$ref": "#/components/responses/NoEncontrada"}}
      }
    },
    "/api/minecraft/entidades/sonidos": {
      "get": {
        "operationId": "listarSonidos",
        "tags": ["Entidades"],
        "description": "No incluye entidades desaparecidas ni Creepers. Si no hay emisores, devuelve una lista vacía.",
        "summary": "Consultar los sonidos de Zombies y Cerdos vivos",
        "responses": {
          "200": {"description": "Sonidos de entidades persistidas", "content": {"application/json": {"schema": {
            "type": "array", "items": {"type": "object", "properties": {
              "id": {"type": "integer", "format": "int64"}, "tipo": {"type": "string"}, "mensaje": {"type": "string"}
            }}
          }}}}
        }
      }
    },
    "/api/minecraft/entidades/{id}/explosion": {
      "parameters": [{"$ref": "#/components/parameters/Id"}],
      "post": {
        "operationId": "detonarCreeper",
        "tags": ["Simulación"],
        "summary": "Detonar un Creeper activo una sola vez (sin cuerpo)",
        "description": "El servicio carga al Creeper y descuenta vida a Zombies y Cerdos vivos a distancia euclídea d ≤ 3 en X/Z. Daño: 12 − 3 × floor(d), limitado por la vida restante. Luego el Creeper queda con vida 0, aun sin objetivos. Todo se guarda en una transacción. Con los tres ejemplos de creación, las vidas finales son Creeper 0, Zombie 11 y Cerdo 4.",
        "responses": {
          "200": {"description": "Explosión guardada", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResultadoExplosion"}}}},
          "400": {
            "description": "Se rechaza sin aplicar daño.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorJuego"}, "examples": {
              "tipoIncorrecto": {"summary": "El ID pertenece a un Zombie o Cerdo", "value": {"codigo": "EXPLOSION_INVALIDA", "error": "Solo un Creeper puede provocar una explosión"}},
              "segundaExplosion": {"summary": "El Creeper ya desapareció", "value": {"codigo": "ENTIDAD_DESAPARECIDA", "error": "La entidad ya desapareció"}}
            }}}
          },
          "404": {"$ref": "#/components/responses/NoEncontrada"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {"name": "id", "in": "path", "required": true, "description": "ID recibido al crear la entidad", "schema": {"type": "integer", "format": "int64"}}
    },
    "requestBodies": {
      "DatosEntidad": {
        "required": true,
        "content": {"application/json": {
          "schema": {"type": "object", "required": ["tipo", "vida", "posicionX", "posicionZ"], "properties": {
            "tipo": {"type": "string", "description": "Creeper, Zombie o Cerdo; se ignoran las mayúsculas y los espacios exteriores."},
            "vida": {"type": "integer", "minimum": 1, "maximum": 20, "description": "Máximo 10 para Cerdo y 20 para Creeper o Zombie."},
            "posicionX": {"type": "integer", "format": "int32"}, "posicionZ": {"type": "integer", "format": "int32"}
          }},
          "examples": {
            "creeper": {"value": {"tipo": "Creeper", "vida": 20, "posicionX": 5, "posicionZ": 5}},
            "zombie": {"value": {"tipo": "Zombie", "vida": 20, "posicionX": 6, "posicionZ": 5}},
            "cerdo": {"value": {"tipo": "Cerdo", "vida": 10, "posicionX": 7, "posicionZ": 5}}
          }
        }}
      }
    },
    "responses": {
      "EstadoGuardado": {"description": "Estado persistido", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Entidad"}}}},
      "NoEncontrada": {"description": "No hay una fila con ese ID", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorJuego"}, "example": {"codigo": "ENTIDAD_NO_ENCONTRADA", "error": "No existe la entidad con id 99"}}}}
    },
    "schemas": {
      "ErrorJuego": {"type": "object", "required": ["codigo", "error"], "properties": {
        "codigo": {"type": "string", "description": "Código estable para identificar la causa."}, "error": {"type": "string", "description": "Mensaje legible."}
      }},
      "Estado": {"type": "object", "properties": {
        "tipo": {"type": "string"}, "vida": {"type": "integer", "minimum": 0}, "vidaMaxima": {"type": "integer"},
        "posicionX": {"type": "integer"}, "posicionZ": {"type": "integer"}, "viva": {"type": "boolean"}
      }},
      "Entidad": {"allOf": [{"$ref": "#/components/schemas/Estado"}, {"type": "object", "properties": {"id": {"type": "integer", "format": "int64"}}}]},
      "ResultadoExplosion": {"type": "object", "properties": {
        "creeperId": {"type": "integer", "format": "int64"}, "creeper": {"$ref": "#/components/schemas/Estado"},
        "radio": {"type": "integer", "example": 3},
        "afectados": {"type": "array", "items": {"type": "object", "properties": {
          "id": {"type": "integer", "format": "int64"}, "tipo": {"type": "string"}, "distancia": {"type": "number"},
          "danioAplicado": {"type": "integer"}, "vidaAnterior": {"type": "integer"}, "vidaActual": {"type": "integer"}, "viva": {"type": "boolean"}
        }}}
      }}
    }
  }
}
